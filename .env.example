# Set by CI to ghcr.io/vaari-dev/hexfield:<commit>. Locally, the tag you built.
APP_IMAGE=hexfield:dev
# Variable. The edge Caddy's shared Docker network.
DOCKER_NETWORK=edge
# Variable. Public hostname; the server refuses requests for any other.
HEXFIELD_DOMAIN=hex.vaari.dev
# Secret. The admin key: the browser that opens /#host=<key> chooses which accounts may
# host games. 16+ characters (openssl rand -hex 32).
HEXFIELD_HOST_KEY=
