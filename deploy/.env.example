# Server settings: CI writes these keys to /opt/hexfield/.env from the oracle-cloud
# GitHub environment (see README, Deploying hex.vaari.dev). Never commit the real file.
# Set by CI to the commit being deployed.
IMAGE_TAG=main
# Variable. Docker network shared with the edge Caddy (vaari-dev/edge).
DOCKER_NETWORK=edge
# Variable. Public hostname; the server refuses requests for any other.
HEXFIELD_DOMAIN=hex.vaari.dev
# Secret. The admin key: the browser that opens /#host=<key> chooses which accounts may
# host games, and hosts its own. 16+ characters (openssl rand -hex 32).
HEXFIELD_HOST_KEY=
