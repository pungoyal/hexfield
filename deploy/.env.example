# The server's /opt/hexfield/.env. CI writes every key below on each deploy, from the
# `oracle-cloud` GitHub environment; a key that is empty or still REPLACE_ME fails the
# deploy before anything on the server changes. Don't edit the server's copy.

# Set by CI: the commit being deployed (the image is ghcr.io/vaari-dev/hexfield:<sha>).
IMAGE_TAG=REPLACE_ME

# Repository variable. The shared network the edge's Caddy is on; must match edge exactly.
DOCKER_NETWORK=edge

# Environment variable. The public hostname; the server refuses requests for any other.
HEXFIELD_DOMAIN=hex.vaari.dev

# Environment secret. Opening https://<HEXFIELD_DOMAIN>/?host=<key> once makes that browser
# the host. At least 16 characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
HEXFIELD_HOST_KEY=REPLACE_ME
